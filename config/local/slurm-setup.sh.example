#!/bin/bash
# Example SLURM setup script
# Copy this file to slurm-setup.sh and customize as needed
# This script is sourced before running the training command

# Example: Load modules
# module load cuda/12.1
# module load python/3.10

# Activate environment (micromamba env + project .venv)
eval "$(micromamba shell hook --shell=bash)"
micromamba activate uv-cu118
source .venv/bin/activate

